# Copy to `.env.local` for local overrides (see Next.js env load order in the docs).
# https://nextjs.org/docs/app/guides/environment-variables

# Public — inlined into the client bundle at build time; safe for non-secrets only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never use the NEXT_PUBLIC_ prefix for secrets or credentials.
DATABASE_URL=
