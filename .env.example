# Copy to `.env.local` for local overrides (see Next.js env load order in the docs).
# https://nextjs.org/docs/app/guides/environment-variables

# Public — inlined into the client bundle at build time; safe for non-secrets only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never use the NEXT_PUBLIC_ prefix for secrets or credentials.
# Prisma 7: Migrate/CLI read `prisma.config.ts`; it uses DIRECT_URL first, otherwise DATABASE_URL.
# Supabase: pooled TRANSACTION URL → DATABASE_URL; direct/host URL → DIRECT_URL for migrations (or duplicate for local Postgres).
DATABASE_URL=
DIRECT_URL=
# Required for signing sessions. Generate: openssl rand -base64 32
AUTH_SECRET=

# Optional public URL for Auth.js in production (and some reverse-proxy setups).
AUTH_URL=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Vercel / production
# ---------------------------------------------------------------------------
# Set these in the Vercel project (Production + Preview if previews use a DB).
# DATABASE_URL and (recommended) DIRECT_URL must be present at build time;
# see prisma.config.ts and DEPLOYMENT.md.
#
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# AUTH_URL=https://your-app.vercel.app
